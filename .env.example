# Copy to .env and fill in. .env is gitignored; never commit real keys.
# Format: KEY=value (no spaces around "=", no quotes).
# Use PERSONAL accounts with spend limits. The app reads this file first and
# ignores same-named variables in your shell (your shell ANTHROPIC_API_KEY may be a work key).

# --- Secrets ---
# Translation (Claude). Create at console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=
# Transcription, speakers, word timestamps. assemblyai.com -> Dashboard -> API Keys.
ASSEMBLYAI_API_KEY=
# Visual moderation (Gemini). aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Config (safe defaults) ---
DATA_DIR=./data
# Providers are chosen by name; run `uv run vd providers` to see the options.
TRANSCRIPTION_PROVIDER=assemblyai
TRANSLATION_PROVIDER=anthropic
MODERATION_PROVIDER=gemini
TEXT_MODERATION_PROVIDER=wordlist
# Models (leave TRANSCRIPTION_MODEL blank for the vendor default).
TRANSCRIPTION_MODEL=
TRANSLATION_MODEL=claude-sonnet-5-5
MODERATION_MODEL=gemini-3.8-flash
# Frames per second sampled for the visual scan (higher = more thorough, more cost).
VISUAL_SAMPLE_FPS=0.5

# --- Phase 2 (dubbing), not needed yet ---
# TTS_PROVIDER=
# ELEVENLABS_API_KEY=
