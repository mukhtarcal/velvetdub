# Copy to .env and fill in. .env is gitignored; never commit real keys.
# Format: KEY=value (no spaces around "=", no quotes).
# Use PERSONAL accounts with spend limits. The app reads this file first and
# ignores same-named variables in your shell (your shell ANTHROPIC_API_KEY may be a work key).

# --- Secrets ---
# Translation (Claude). Create at console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=
# Transcription, speakers, word timestamps. assemblyai.com -> Dashboard -> API Keys.
ASSEMBLYAI_API_KEY=
# Visual moderation (Gemini). aistudio.google.com/apikey
GEMINI_API_KEY=
# Frame-by-frame decisions (OpenAI Decisions API). platform.openai.com -> API keys.
OPENAI_API_KEY=

# --- Config (safe defaults) ---
DATA_DIR=./data
# Providers are chosen by name; run `uv run vd providers` to see the options.
TRANSCRIPTION_PROVIDER=assemblyai
TRANSLATION_PROVIDER=anthropic
# Scene scan: `gemini` (whole clips, nudity + violence + drugs + scary) or `openai` (frame by
# frame, nudity + sexual content only). MODERATION_MODEL must match, e.g. gpt-6-luna.
MODERATION_PROVIDER=gemini
TEXT_MODERATION_PROVIDER=wordlist
# Models (leave TRANSCRIPTION_MODEL blank for the vendor default).
TRANSCRIPTION_MODEL=
TRANSLATION_MODEL=claude-sonnet-5-5
MODERATION_MODEL=gemini-3.8-flash
# Frames per second sampled for the visual scan (higher = more thorough, more cost).
VISUAL_SAMPLE_FPS=0.5
# Frame-by-frame scan (openai) only: chance (0-1) at which a window counts as nudity or sexual
# content. Lower catches subtler scenes but adds false alarms.
FRAME_THRESHOLD=0.5

# --- Dubbing (optional): also needs `uv sync --group dubbing` for voice separation (Demucs) ---
# Voice copying and speech (Cartesia). Paid per character: every recorded line is cached, so
# re-running a title costs nothing. play.cartesia.ai -> API keys.
CARTESIA_API_KEY=
# TTS_PROVIDER=cartesia
# TTS_MODEL=sonic-3.6
# How many lines are spoken at the same time (1 to 16).
# TTS_CONCURRENCY=4
# SEPARATION_PROVIDER=demucs
# Voice separation files crowds, chanting and singing under "dialogue", which a dub replaces. This
# keeps the original sound wherever no actor is speaking. Mixing again costs no credits.
# DUB_KEEP_CROWD=true
# In a crowd scene, how much of the original stays under a line (0 to 1). Off by default: the
# crowd and the actor are one sound, so any bed also keeps his own voice audible behind the dub.
# DUB_CROWD_BED=0
